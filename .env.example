# Copy to .env.local. Everything works without any keys — detection,
# tracing, analysis, enforcement and reports are all self-contained.

# --- Investigator console auth ------------------------------------------------
# Operator sign-in code (operators can file complaints, protect, trace,
# analyze, freeze, release). If unset, a random code is generated per process
# and printed once in the server console. Use 12+ characters outside demos.
MNH_OPERATOR_CODE=
# HMAC secret for session cookies. If unset, a random per-process secret is
# used (everyone is signed out on restart).
# MNH_SESSION_SECRET=
# Trust x-forwarded-for for rate limiting only behind a proxy that sets it.
# MNH_TRUST_PROXY=1

# --- Persistence / simulation ---------------------------------------------------
# SQLite file (node:sqlite, single process). Default: data/mulehunter.db
# MNH_DB_PATH=data/mulehunter.db
# Background simulated payments per second through the durable ledger (default 250).
# MNH_BASE_TPS=250
# Accepted-history retention for complaint tracing, minutes (default 120).
# MNH_HISTORY_RETENTION_MIN=120
# Allow the explicitly-labelled demo auto-enforcement policy (default off).
# MNH_DEMO_AUTO_ENFORCE=1

# --- Optional LLM prose for the live /hunt ring report --------------------------
# Enables Claude-drafted prose for the live-console ring report (otherwise a
# deterministic template is used). Case reports never use an LLM.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Account VPAs are pseudonymised before being sent to the model unless set:
# MNH_LLM_SHARE_ACCOUNT_DETAILS=1
