{
  "name": "mulehunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:verify": "node scripts/build-verify.mjs",
    "test:e2e": "node scripts/build-verify.mjs && playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "d3-force": "^3.0.0",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
